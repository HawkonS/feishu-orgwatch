# feishu-orgwatch 主要配置来自 feishu-orgwatch.properties（首次启动自动生成）。
# Docker 或特殊部署可用 ORGWATCH_* 环境变量覆盖，规则：ORGWATCH_ + 配置项大写、点号换成下划线。
# 例如 app.port -> ORGWATCH_APP_PORT，feishu.app-id -> ORGWATCH_FEISHU_APP_ID。

ORGWATCH_WORKSPACE=.
ORGWATCH_APP_HOST=0.0.0.0
ORGWATCH_APP_PORT=18080
ORGWATCH_APP_PUBLIC_BASE_URL=http://127.0.0.1:18080
ORGWATCH_SECURITY_SECRET_KEY=
